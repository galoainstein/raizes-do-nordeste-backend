              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();\r\nif (response.accessToken) {\r\n    pm.environment.set(\"token\", response.accessToken);\r\n    console.log(\"Token salvo:\", response.accessToken);\r\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"cliente@teste.com\",\r\n  \"senha\": \"Senha@123\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
